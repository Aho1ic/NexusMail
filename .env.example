NEXUSMAIL_LISTEN_ADDR=:8080
NEXUSMAIL_DATA_DIR=./data
NEXUSMAIL_DATABASE_PATH=./data/mail.db
NEXUSMAIL_PUBLIC_URL=http://localhost:13737
NEXUSMAIL_API_KEY=replace-with-at-least-32-random-characters
# Generate with: openssl rand -base64 32
NEXUSMAIL_MASTER_KEY=
# 下面四个 OAuth 变量是可选的启动默认值：也可以在应用「设置 → OAuth」页面填写
# Client ID 与 Secret，Secret 会用主密钥加密后落库，且页面配置优先于环境变量。
# 改这里的变量需要重启容器才生效，页面上保存则立即生效。
NEXUSMAIL_GOOGLE_CLIENT_ID=
NEXUSMAIL_GOOGLE_CLIENT_SECRET=
NEXUSMAIL_MICROSOFT_CLIENT_ID=
NEXUSMAIL_MICROSOFT_CLIENT_SECRET=
NEXUSMAIL_BLOB_CACHE_BYTES=2147483648
NEXUSMAIL_MAX_OUTBOUND_BYTES=20971520
NEXUSMAIL_LOG_LEVEL=info
# Comma separated CIDRs or addresses of reverse proxies allowed to set
# X-Forwarded-For. Leave empty when nothing sits in front of the app: the login
# throttle is keyed on the client address, and trusting the header unconditionally
# lets a caller mint a fresh budget per request.
NEXUSMAIL_TRUSTED_PROXIES=
